# 🛡️ Sentinel: Examply Environment Configuration
# Copy this file to .env and fill in your API keys.
# DO NOT commit .env files to version control.

# NVIDIA API Key for Frontend (Proxied through Vite)
# Note: Vite requires 'VITE_' prefix to expose variables to the client-side code.
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA API Key for Scripts (Node.js environment)
NVIDIA_API_KEY=your_nvidia_api_key_here
