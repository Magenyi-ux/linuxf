# NVIDIA API Key for NVIDIA NIM
NV_API_KEY=your_nvidia_api_key_here

# Gemini API Key (if used)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Credentials for /api/admin/logs
ADMIN_EMAIL=admin@example.com
